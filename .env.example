# --- CONNECTION ---
MUMBLE_SERVER_IP=127.0.0.1
MUMBLE_SERVER_PORT=64738
MUMBLE_BOT_USERNAME=Obama
MUMBLE_PASSWORD=your_mumble_password
MUMBLE_TARGET_CHANNEL=General
MUMBLE_IGNORED_USERS=YoMusicBot
MUMBLE_RECONNECT_DELAY=5

# --- WEB SERVER & TTS API ---
WEB_SERVER_ENABLED=True
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
API_SERVER_ENABLED=True
API_SERVER_PORT=8081

# --- OLLAMA / LLM CONFIG ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e2b
OLLAMA_THINK_BUFFER=1024
LLM_DISABLE_THINKING=True
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=3


# --- AI CONFIG ---
MEMORY_ENABLED=True

# --- TTS CONFIG ---
CHATTERBOX_MODEL=nano
CHATTERBOX_VOICE_DIR=data/voices
CHATTERBOX_DEFAULT_VOICE=michael
CHATTERBOX_TEMPERATURE=0.8
