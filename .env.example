# --- BACKEND SELECTOR ---
# false = Mumble (default), true = TeamSpeak 6 (query :10022 + voice bridge)
USE_TEAMSPEAK=False

# --- TEAMSPEAK 6 (only used when USE_TEAMSPEAK=True) ---
TS6_HOST=127.0.0.1
TS6_QUERY_PORT=10022
TS6_QUERY_USER=serveradmin
TS6_QUERY_PASSWORD=
TS6_SERVER_ID=1
# Defaults fall back to MUMBLE_BOT_USERNAME / MUMBLE_TARGET_CHANNEL when unset:
# TS6_NICKNAME=${MUMBLE_BOT_USERNAME}
# TS6_CHANNEL=${MUMBLE_TARGET_CHANNEL}
TS6_CHANNEL_PASSWORD=
TS6_VOICE_HOST=127.0.0.1
TS6_VOICE_PORT=9987
TS6_SERVER_PASSWORD=
TS6_IDENTITY=
TS6_BRIDGE_RX_PORT=5001
TS6_BRIDGE_TX_PORT=5002
TS6_BRIDGE_TOKEN=

# --- CONNECTION ---
MUMBLE_SERVER_IP=127.0.0.1
MUMBLE_SERVER_PORT=64738
MUMBLE_BOT_USERNAME=Obama
MUMBLE_PASSWORD=your_mumble_password
MUMBLE_TARGET_CHANNEL=General
MUMBLE_IGNORED_USERS=YoMusicBot
MUMBLE_RECONNECT_DELAY=5

# --- OLLAMA / LLM CONFIG ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e2b
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=3

# --- AI CONFIG ---
MEMORY_ENABLED=True

# --- TTS EXTERNAL API CONFIG ---
TTS_API_URL=http://localhost:8000
TTS_VOICE=voice_fi
TTS_LANGUAGE=fi
TTS_SPEED=1.0
TTS_NUM_STEP=32
TTS_GUIDANCE_SCALE=2.0
TTS_RESPONSE_FORMAT=wav
TTS_SEED=42
TTS_TIMEOUT=30
