# --- CONNECTION ---
MUMBLE_SERVER_IP=127.0.0.1
MUMBLE_SERVER_PORT=64738
MUMBLE_BOT_USERNAME=Obama
MUMBLE_PASSWORD=your_mumble_password
MUMBLE_TARGET_CHANNEL=General
MUMBLE_IGNORED_USERS=YoMusicBot
MUMBLE_RECONNECT_DELAY=5

# --- OLLAMA / LLM CONFIG ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e2b
LLM_DISABLE_THINKING=True


# --- AI CONFIG ---
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
WHISPER_LANGUAGE=fi
LLM_CONTEXT_SIZE=2000
MEMORY_ENABLED=True

# --- TTS CONFIG ---
TTS_ENGINE=chatterbox-turbo  # "kokoro" or "chatterbox-turbo"
KOKORO_VOICE_ID=am_michael
KOKORO_SPEED=0.9
CHATTERBOX_VOICE_DIR=data/voices
CHATTERBOX_DEFAULT_VOICE=michael
CHATTERBOX_TEMPERATURE=0.8


