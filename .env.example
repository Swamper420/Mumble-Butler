# --- CONNECTION ---
MUMBLE_SERVER_IP=127.0.0.1
MUMBLE_SERVER_PORT=64738
MUMBLE_BOT_USERNAME=Obama
MUMBLE_PASSWORD=your_mumble_password
MUMBLE_TARGET_CHANNEL=General
MUMBLE_IGNORED_USERS=YoMusicBot
MUMBLE_RECONNECT_DELAY=5

# --- WEB SERVER ---
WEB_SERVER_ENABLED=True
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# --- OLLAMA / LLM CONFIG ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e2b
OLLAMA_THINK_BUFFER=1024
LLM_DISABLE_THINKING=True
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=3


# --- AI CONFIG ---
MEMORY_ENABLED=True

# --- TTS CONFIG & CHATTERBOX VOICE FINE-TUNING ---
CHATTERBOX_MODEL=nano
CHATTERBOX_VOICE_DIR=data/voices
CHATTERBOX_DEFAULT_VOICE=michael
CHATTERBOX_LANGUAGE=fi
CHATTERBOX_TEMPERATURE=0.8
CHATTERBOX_TOP_P=0.95
CHATTERBOX_TOP_K=50
CHATTERBOX_REPETITION_PENALTY=1.2
CHATTERBOX_EXAGGERATION=0.6
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_PITCH=1.0
CHATTERBOX_SPEED=1.0
CHATTERBOX_SEED=-1
CHATTERBOX_VOICE_CACHE_LIMIT=1
CHATTERBOX_MAX_CHARS=350
CHATTERBOX_MIN_CHARS=10

