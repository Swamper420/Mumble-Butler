# --- CONNECTION ---
MUMBLE_SERVER_IP=127.0.0.1
MUMBLE_SERVER_PORT=64738
MUMBLE_BOT_USERNAME=Obama
MUMBLE_PASSWORD=your_mumble_password
MUMBLE_TARGET_CHANNEL=General
MUMBLE_IGNORED_USERS=YoMusicBot
MUMBLE_RECONNECT_DELAY=5

# --- OLLAMA / LLM CONFIG ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4-e2b
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MAX_RESULTS=3

# --- AI CONFIG ---
MEMORY_ENABLED=True

# --- TTS EXTERNAL API CONFIG ---
TTS_API_URL=http://localhost:8000
TTS_VOICE=voice_fi
TTS_LANGUAGE=fi
TTS_SPEED=1.0
TTS_NUM_STEP=32
TTS_GUIDANCE_SCALE=2.0
TTS_RESPONSE_FORMAT=wav
TTS_SEED=42
TTS_TIMEOUT=30
